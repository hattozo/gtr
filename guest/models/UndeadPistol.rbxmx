		<Item class="Script" referent="RBX375">
			<Properties>
				<ProtectedString name="Source"><![CDATA[damage = 7

game:GetService("Debris"):AddItem(script.Parent, 8)

function onTouched(hit)
	if(hit.Parent==nil)then return end

	if(hit.Parent:findFirstChild("Humanoid")~=nil)and
	(hit.Parent:FindFirstChild("creator")~=nil)then
		connection:disconnect()
		hit.Parent["Humanoid"]:TakeDamage(damage)

		local creator = script.Parent.creator:Clone()
		creator.Value = script.Parent.creator.Value
		creator.Parent = hit.Parent.Humanoid

		wait(.25)

		creator:remove()
	end

	script.Parent:Remove()
end
connection = script.Parent.Touched:connect(onTouched)
]]></ProtectedString>
