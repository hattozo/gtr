+// How much a see-through fragment covers, and how far along the view it is, for a view that keeps them (SceneView's
+// transparent coverage): the nearest distance is kept, and the coverages are laid over one another
+@fragment
+fn fs_coverage(in: VertexOutput) -> @location(0) vec4<f32> {
+    let alpha = shade(in, localDerivatives(in)).color.a;
+    return vec4<f32>(in.world.w, in.world.w, in.world.w, alpha);
+}
+
 @fragment
 fn fs_glass_filter(in: VertexOutput) -> @location(0) vec4<f32> {
