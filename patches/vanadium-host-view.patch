+
+// The see-through parts drawn again, each fragment's coverage and distance instead of its color, against the resolved depth
+// so the opaque parts hide what is behind them
+void SceneView::DrawCoverage(WGPUCommandEncoder encoder, ContentProvider &provider) {
+    if (mCoverageTexture == nullptr || mCoverageWidth != mWidth || mCoverageHeight != mHeight) {
+        if (mCoverageView != nullptr)
+            wgpuTextureViewRelease(mCoverageView);
+        if (mCoverageTexture != nullptr)
+            wgpuTextureRelease(mCoverageTexture);
+        CreateTarget(mGpu.Device, "SceneCoverage", CoverageFormat, WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding,
+                     WGPUTextureAspect_All, mWidth, mHeight, 1, mCoverageTexture, mCoverageView);
+        mCoverageWidth = mWidth;
+        mCoverageHeight = mHeight;
+    }
+    mCoverageBatches.clear();
+    // The adorns (a tool's outline of a part) too: they are drawn over the finished picture, with no depth of their own
+    for (const std::vector<DrawBatch> *batches : { &mBlurredTransparentBatches, &mTransparentBatches, &mAdornBatches }) {
+        for (DrawBatch batch : *batches) {
+            if (batch.SurfaceGui >= 0 || batch.PlaneEffect >= 0 || mResources.CoveragePipeline == nullptr)
+                continue;
+            batch.Pipeline = mResources.CoveragePipeline;
+            mCoverageBatches.push_back(batch);
+        }
+    }
+    const WGPUColor empty { EmptyCoverageDepth, EmptyCoverageDepth, EmptyCoverageDepth, 0.0 };
+    WGPURenderPassEncoder pass = BeginPass(encoder, { ColorAttachment(mCoverageView, WGPULoadOp_Clear, empty) }, mDepthView, WGPULoadOp_Load,
+                                           "SceneCoverage");
+    DrawBatches(pass, mCoverageBatches, provider);
+    EndPass(pass);
+}
